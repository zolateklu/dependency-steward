# Copy to .env. Keep .env out of Git and never paste its values into chat.
OPERATOR_TOKEN=
WORKER_TOKEN=
GITHUB_REPO=zolateklu/dependency-steward
# Fine-grained PAT: only the demo repository; Contents, Pull requests, Actions read/write.
# No administration or workflow-file permission is needed at runtime.
GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SLACK_WEBHOOK=
# SQLite is for local development only. Deployment uses Firestore.
DATABASE_URL=sqlite:///./steward.db
FIRESTORE_PROJECT=
SOURCE_PATHS=["src/schema.ts"]
NODE_VERSION=24.6.0
NPM_VERSION=11.8.0
